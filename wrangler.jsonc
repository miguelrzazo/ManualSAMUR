{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manualsamur-local",
  "account_id": "6ffc759b5191c3017d52a92cf35b0d94",
  "main": "backend/src/worker.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/gestion-editorial*", "/manual/*", "/mobile-history/*", "/procedures/*", "/llms.txt", "/llms-full.txt"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-local", "migrations_dir": "backend/migrations" }],
  "vars": { "PUBLICATION_REPOSITORY": "miguelrzazo/ManualSAMUR", "PUBLICATION_REF": "main" },
  "env": {
    "staging": {
      "name": "manualsamur-staging",
      "services": [{ "binding": "FILES", "service": "manualsamur-files-staging" }],
      "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-staging", "migrations_dir": "backend/migrations" }],
      "vars": { "PUBLICATION_REPOSITORY": "miguelrzazo/ManualSAMUR", "PUBLICATION_REF": "main" }
    },
    "production": {
      "name": "manualsamur",
      "services": [{ "binding": "FILES", "service": "manualsamur-files" }],
      "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-production", "database_id": "dfb4af8a-3eab-4adf-98ba-2886f1d49272", "migrations_dir": "backend/migrations" }],
      "vars": { "PUBLICATION_REPOSITORY": "miguelrzazo/ManualSAMUR", "PUBLICATION_REF": "main" }
    }
  }
}
