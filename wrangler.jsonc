{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manualsamur-local",
  "account_id": "6ffc759b5191c3017d52a92cf35b0d94",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [{ "binding": "CONTENT_WORKFLOW", "name": "manualsamur-content-local", "class_name": "ContentWorkflow" }],
  "kv_namespaces": [{ "binding": "CONTENT_ASSETS", "id": "local-content-assets" }],
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/gestion-editorial*", "/admin", "/admin/", "/auth/*", "/docs/_cloud/*", "/manual", "/manual/*", "/mobile-history/*", "/procedures/*", "/llms.txt", "/llms-full.txt", "/abreviaturas*", "/acerca-de*", "/cambios*", "/codigos*", "/colaboradores*", "/grafo*", "/mapa*", "/privacidad*", "/soporte*", "/vademecum*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-local", "migrations_dir": "backend/migrations" }],
  "vars": {},
  "env": {
    "production": {
      "name": "manualsamur",
      "workflows": [{ "binding": "CONTENT_WORKFLOW", "name": "manualsamur-content", "class_name": "ContentWorkflow" }],
      "kv_namespaces": [{ "binding": "CONTENT_ASSETS", "id": "34ec6af98a98420f86b5f4f5c87d747e" }],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["0 4 1 * *"] },
      // Canonical domain; workers.dev stays enabled for apps built before the move.
      "routes": [{ "pattern": "manualsamur.apta-academy.com", "custom_domain": true }],
      "workers_dev": true,
      "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-production", "database_id": "dfb4af8a-3eab-4adf-98ba-2886f1d49272", "migrations_dir": "backend/migrations" }],
      "vars": { "AUTH_ORIGIN": "https://manualsamur.apta-academy.com" }
    }
  }
}
