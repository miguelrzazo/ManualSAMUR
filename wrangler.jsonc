{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manualsamur-local",
  "account_id": "6ffc759b5191c3017d52a92cf35b0d94",
  "main": "backend/src/worker.ts",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/gestion-editorial*", "/manual", "/manual/*", "/mobile-history/*", "/procedures/*", "/llms.txt", "/llms-full.txt", "/abreviaturas*", "/acerca-de*", "/cambios*", "/codigos*", "/colaboradores*", "/grafo*", "/mapa*", "/privacidad*", "/soporte*", "/vademecum*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-local", "migrations_dir": "backend/migrations" }],
  "vars": { "PUBLICATION_REPOSITORY": "miguelrzazo/ManualSAMUR", "PUBLICATION_REF": "main" },
  "env": {
    "production": {
      "name": "manualsamur",
      // Canonical domain; workers.dev stays enabled for apps built before the move.
      "routes": [{ "pattern": "manualsamur.apta-academy.com", "custom_domain": true }],
      "workers_dev": true,
      "d1_databases": [{ "binding": "DB", "database_name": "manualsamur-production", "database_id": "dfb4af8a-3eab-4adf-98ba-2886f1d49272", "migrations_dir": "backend/migrations" }],
      "vars": { "PUBLICATION_REPOSITORY": "miguelrzazo/ManualSAMUR", "PUBLICATION_REF": "main" }
    }
  }
}
