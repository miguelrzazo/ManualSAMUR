# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# pdf.js worker — generated from node_modules during build
/public/pdf.worker.min.mjs

# Datasets de cliente — los regenera `npm run generate:client-data` en cada build.
# Sin ignorar, cada PR mensual de contenido arrastraría ~3,4 MB de diff generado y
# ocultaría los cambios clínicos reales, que es justo lo que se revisa a mano.
/public/search-index.json
/public/manual-updates.json
/public/manual-history.json

# typescript
*.tsbuildinfo
next-env.d.ts
HistoricoActualizaciones_abril 2026.pdf.pdf
# Expo local state and generated native projects (Continuous Native Generation).
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/

# Simulator/device screenshots captured while manually verifying mobile builds.
/.claude-screenshots/
