     });
 }
+
+export function buildSectionEntries(procedures: ProcedureMeta[]): SectionEntry[] {
+  return procedures.flatMap((p) =>
+    (p.sections ?? []).map((s) => ({
+      procedureId: p.id,
+      procedureSlug: p.slug,
+      procedureTitle: p.title,
+      procedureSection: p.section,
+      sectionHeading: s.heading,
+      sectionAnchor: s.anchor,
+      sectionSearchText: s.searchText,
+    }))
+  );
+}
+
+export function searchSections(query: string, entries: SectionEntry[]): SectionSearchResult[] {
+  if (!query.trim() || !entries.length) return [];
+
+  const fuse = new Fuse(entries, {
+    keys: [
+      { name: "sectionHeading", weight: 1.8 },
+      { name: "sectionSearchText", weight: 1.0 },
+      { name: "procedureTitle", weight: 0.5 },
+    ],
+    threshold: 0.35,
+    includeScore: true,
+    includeMatches: true,
+    ignoreLocation: true,
+    ignoreDiacritics: true,
+    minMatchCharLength: 2,
+  });
+
+  return fuse.search(query).map((result) => {
+    const matchedKey = result.matches?.[0]?.key ?? "sectionSearchText";
+    const snippet =
+      matchedKey === "sectionSearchText"
+        ? buildSnippet(result.item.sectionSearchText, query) ?? undefined
+        : undefined;
+
+    return {
+      item: result.item,
+      score: result.score ?? 1,
+      snippet,
+    };
+  });
+}
