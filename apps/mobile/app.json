{
  "expo": {
    "name": "Pulso abierto",
    "slug": "manualsamur",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "manualsamur",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D92732"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.madrid.samur.manual",
      "infoPlist": {
        "CFBundleDisplayName": "Pulso abierto",
        "NSLocationWhenInUseUsageDescription": "Usa tu ubicación solo cuando lo solicites para ordenar hospitales y bases cercanos. El directorio y el esquema funcionan sin ubicación."
      },
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#D92732"
      },
      "package": "es.madrid.samur.manual",
      "label": "Pulso abierto"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usa tu ubicación solo cuando lo solicites para ordenar hospitales y bases cercanos. El directorio y el esquema funcionan sin ubicación."
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      "./plugins/with-ios-launch-screen",
      "./plugins/with-ios-podfile-safe-scripts",
      "./plugins/with-ios-attachment-assets",
      "./plugins/with-android-attachment-assets",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "contentEndpoint": "https://manual-proced-spc.vercel.app/api/mobile/content/v2",
      "metadataEndpoint": "https://manual-proced-spc.vercel.app/api/mobile/content/metadata"
    }
  }
}
